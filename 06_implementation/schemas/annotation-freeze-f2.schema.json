{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnnotationFreezeF2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "F1_hash",
    "test_input_manifest_hash",
    "test_pool_hash",
    "qrels_hash",
    "rubric_version",
    "annotation_version",
    "incident_ids",
    "judged_coverage",
    "reviewer_receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "cs221-annotation-freeze-f2-v1"
    },
    "created_at_utc": {
      "type": "string"
    },
    "F1_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_input_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_pool_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qrels_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rubric_version": {
      "type": "string"
    },
    "annotation_version": {
      "type": "string"
    },
    "incident_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^inc_[0-9a-f]{16}$"
      },
      "minItems": 18,
      "maxItems": 18
    },
    "judged_coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "top5_coverage_ratio",
        "top10_coverage_ratio",
        "required_pairs_count",
        "judged_pairs_count"
      ],
      "properties": {
        "top5_coverage_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "top10_coverage_ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "required_pairs_count": {
          "type": "integer",
          "minimum": 0
        },
        "judged_pairs_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reviewer_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
