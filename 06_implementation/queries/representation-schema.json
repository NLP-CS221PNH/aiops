        "observation_end_exclusive",
        "window_policy"
      ]
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "source_file_id": {
          "type": "string"
        },
        "transform_version": {
          "type": "string"
        },
        "redaction_version": {
          "type": "string"
        },
        "source_row_start": {
          "type": "integer",
          "minimum": 0
