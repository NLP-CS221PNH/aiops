        "source_char_end": {
          "type": "integer",
          "minimum": 0
        },
        "source_text_hash": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "offset_unit": {
          "const": "unicode_codepoint"
        }
      },
      "required": [
        "evidence_id",
        "source_file_id",
        "transform_version",
        "redaction_version"
