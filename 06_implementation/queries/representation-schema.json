        "telemetry_is_synthetic": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ok",
            "insufficient_evidence"
          ]
        },
        "input_manifest_hash": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "config_hash": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "tokenizer_hash": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "normalization_version": {
          "type": "string"
        },
        "redaction_version": {
          "type": "string"
        },
        "transform_version": {
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "query_id",
        "representation_id",
        "representation_version",
        "query_text",
        "query_hash",
        "window",
        "evidence_ids",
        "log_evidence_ids",
        "source_spans",
        "missing_information",
        "query_is_synthetic",
        "telemetry_is_synthetic",
        "status",
        "input_manifest_hash",
        "config_hash",
        "tokenizer_hash",
        "normalization_version",
        "redaction_version",
        "transform_version"
