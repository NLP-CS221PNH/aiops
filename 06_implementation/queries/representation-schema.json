        "universe_hash",
        "candidate_log_ids",
        "selected_log_ids",
        "dropped_log_ids",
        "dropped_logs",
        "selected_metric_ids",
        "selected_trace_ids",
        "enrichment_dropped",
        "source_selection_loss",
        "ordering",
        "retained_log_ids",
        "budget_dropped_logs"
