{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs221:representation-schema:v1",
  "title": "Plan 04 safe query and common observation bundle contracts",
  "description": "Validate each JSONL row with its artifact-specific $defs entry. query.config_hash is canonical representation configuration; manifest.config_hash is configuration file bytes. Query/token/bundle tokenizer_hash binds the tokenizer asset; manifest.tokenizer_hash binds the complete tokenizer policy. Offsets are half-open Unicode code points in the redacted safe export. Bundle hash is canonical JSON of all bundle fields except bundle_hash. No private manager fields are accepted.",
  "$defs": {
"manifest": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cs221-query-manifest-v1"
    },
    "milestone": {
      "const": "04.variants"
    },
    "status": {
      "const": "candidate"
    },
    "representation_version": {
      "type": "string"
    },
    "input_manifest_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "config_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "config_content_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "tokenizer_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "implementation_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "implementation": {
      "type": "object",
      "description": "Repository-relative implementation and public policy paths mapped to exact SHA-256 file hashes."
    },
    "dependencies_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pyarrow": {
              "type": "string"
            },
            "tokenizers": {
              "type": "string"
            }
          },
          "required": [
            "pyarrow",
            "tokenizers"
          ]
        },
        "lock_hashes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configs/requirements-lock.txt": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            },
            "configs/corpus-requirements-lock.txt": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            }
          },
          "required": [
            "configs/requirements-lock.txt",
            "configs/corpus-requirements-lock.txt"
          ]
        }
      },
      "required": [
        "python",
        "packages",
        "lock_hashes"
      ]
    },
    "schema_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "manager_selection_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "manager_config_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "variant_ids": {
      "type": "array",
      "items": {
        "enum": [
          "R1",
          "R2",
          "R3"
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incidents": {
          "type": "integer",
          "minimum": 0
        },
        "queries": {
          "type": "integer",
          "minimum": 0
        },
        "selections": {
          "type": "integer",
          "minimum": 0
        },
        "token_ledgers": {
          "type": "integer",
          "minimum": 0
        },
        "bundles": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "incidents",
        "queries",
        "selections",
        "token_ledgers",
        "bundles"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "rows"
        ]
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "test_materialization": {
      "const": "not_performed_requires_plan08_F1"
    }
  },
  "required": [
    "schema_version",
    "milestone",
    "status",
    "representation_version",
    "input_manifest_hash",
    "config_hash",
    "config_content_hash",
    "tokenizer_hash",
    "implementation_hash",
    "implementation",
    "dependencies_hash",
    "dependencies",
    "schema_hash",
    "manager_selection_hash",
    "manager_config_hash",
    "variant_ids",
    "counts",
    "outputs",
    "errors",
    "test_materialization"
  ]
},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_start": {
          "type": "string"
        },
        "observation_end_exclusive": {
          "type": "string"
        },
        "window_policy": {
          "type": "string"
        }
      },
      "required": [
