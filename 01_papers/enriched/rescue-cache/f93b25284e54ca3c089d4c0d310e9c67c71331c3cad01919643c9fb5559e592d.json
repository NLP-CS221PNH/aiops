{"url": "https://www.usenix.org/legacy/event/fast09/tech/tech.html", "requested_at": "2026-09-12T17:14:29.518915+00:00", "status": 200, "final_url": "https://www.usenix.org/legacy/event/fast09/tech/tech.html", "content_type": "text/html", "text": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"https://www.w3.org/TR/html4/loose.dtd\">\n<html><head><meta content=\"text/html; charset=latin-1\" http-equiv=\"Content-Type\"/><title>FAST '09 Technical Sessions</title><style type=\"text/css\">\n<!--\n@import url(/legacy/style.css);\n@import url(/legacy/events/conf.css);\n@import url(../fast09.css);\n-->\n</style></head><body bgcolor=\"#ffffff\" id=\"tech\">\n<center>\n<!--START TABLE 1-->\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:url(../art/back_border.gif);\" width=\"750\">\n<tr>\n<!--banner-->\n<td colspan=\"2\">\n<img alt=\"FAST '09 Banner\" height=\"120\" src=\"../art/fast09_banner.jpg\" width=\"750\"/></td>\n<!--end banner-->\n</tr>\n<tr>\n<td bgcolor=\"#ffffff\" colspan=\"2\" valign=\"bottom\">\n<!-- insert topmenu -->\n<ul id=\"topbar\" class=\"nav\">\n<!--<li id=\"topbar-01\"><a href=\"/legacy/events/fast09/\">FAST '09 Home</a></li> -->\n\n<li id=\"topbar-02\"><a href=\"/legacy/\">USENIX Home</a></li>\n\n<li id=\"topbar-03\"><a href=\"/legacy/events/\">Conferences</a></li>\n\n<li id=\"topbar-04\"><a href=\"/legacy/publications/library/proceedings/\">Publications</a></li>\n\n<li id=\"topbar-05\"><a href=\"/legacy/membership/\">Membership</a></li>\n\n  </ul>\n</td>\n</tr>\n<!--begin spacer-->\n<tr>\n<td colspan=\"2\" height=\"6\">\n<img alt=\"\" height=\"6\" src=\"../art/longbar.gif\" width=\"750\"/>\n</td>\n</tr>\n<!--end spacer-->\n<tr>\n<td valign=\"top\" width=\"150\">\n<!--begin left menu-->\n<ul class=\"nav\" id=\"left-navlist\">\n<!-- insert menu -->\n<li><a href=\"/legacy/events/fast09/\" id=\"nav-home\"><b>FAST '09 Home</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/registration/\"  id=\"nav-reg\"><b>Registration</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/organizers.html\" id=\"nav-organizers\"><b>Organizers</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/invitation.html\" id=\"nav-invitation\"><b>Invitation</b></a></li>\n\n<li><span id=\"bar\"><img src=\"/legacy/events/fast09/art/left_bar.gif\" width=\"150\" height=\"2\" border=\"0\" alt=\"\"></span></li>\n\n<li><a href=\"/legacy/events/fast09/ataglance.html\" id=\"nav-glance\"><b>At a Glance</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/tutorials/\" id=\"nav-tut\"><b>Tutorials</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/tech/\" id=\"nav-tech\"><b>Tech Sessions</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/wips.html\" id=\"nav-wips\"><b>WiPs</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/poster.html\" id=\"nav-poster\"><b>Poster Session</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/bofs.html\" id=\"nav-bofs\"><b>BoFs</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/workshops.html\" id=\"nav-workshops\"><b>Workshops</b></a></li>\n\n<li><span id=\"bar\"><img src=\"/legacy/events/fast09/art/left_bar.gif\" width=\"150\" height=\"2\" border=\"0\" alt=\"\"></span></li>\n\n<li><a href=\"/legacy/events/fast09/sponsors.html\" id=\"nav-sponsors\"><b>Sponsors</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/activities.html\" id=\"nav-activities\"><b>Activities</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/hotel.html\" id=\"nav-hotel\"><b>Hotel/Travel</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/services.html\" id=\"nav-services\"><b>Services</b></a></li>\n\n<li><span id=\"bar\"><img src=\"/legacy/events/fast09/art/left_bar.gif\" width=\"150\" height=\"2\" border=\"0\" alt=\"\"></span></li>\n\n<li><a href=\"/legacy/events/fast09/students.html\" id=\"nav-students\"><b>Students</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/questions.html\" id=\"nav-questions\"><b>Questions?</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/promote.html\" id=\"nav-promote\"><b>Help Promote!</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/fast09_flyer.pdf\" ID=\"nav-brochure\"><b>Flyer PDF</b></a></li>\n\n<li><span id=\"bar\"><img src=\"/legacy/events/fast09/art/left_bar.gif\" width=\"150\" height=\"2\" border=\"0\" alt=\"\"></span></li>\n\n<li><a href=\"/legacy/events/fast09/cfp/\" id=\"nav-cfp\"><b>Call for Papers</b></a></li>\n\n<li><a href=\"/legacy/events/bytopic/fast.html\" id=\"nav-past\"><b>Past Proceedings</b></a></li>\n\n<li><a href=\"/legacy/events/fast09/instrux\" id=\"nav-authors\"><b>Authors</b></a></li>\n\n<li><span id=\"bar\"><img src=\"/legacy/events/fast09/art/left_bottom.gif\" alt=\"\" width=\"150\" height=\"20\"></span></li>\n\n</ul>\n\n\n<!--end left menu--></ul>\n<img alt=\"\" height=\"7\" src=\"/legacy/graphics/dot_clear.gif\" width=\"2\"/><br/>\n<!--start sidebar images\n\n<table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"10\" align=\"center\">\n\n</table>\nEnd Sidebar Images-->\n</td>\n<td align=\"left\" valign=\"top\" width=\"590\">\n<!--START TABLE 2: BEGIN MAIN TABLE-->\n<table align=\"center\" border=\"0\" cellpadding=\"5\" cellspacing=\"0\" width=\"100%\">\n<tr>\n<td valign=\"top\">\n<!-- START OF PAGE CONTENTS -->\n<!--REGISTER NOW BUTTON-->\n<p class=\"subhead1\">\n<!--<a href=\"https://db.usenix.org/cgi-bin/Conference/fast09/reg.cgi\">\n<img src=\"../art/register_now.gif\" border=\"0\" width=\"95\" height=\"16\" alt=\"Register Now!\" align=\"LEFT\"></a>\n&nbsp;&nbsp;-->TECHNICAL SESSIONS</p>\n<!--Begin Front Matter-->\n</td></tr><tr>\n<td colspan=\"2\">Conference papers are available to conference registrants immediately and to everyone beginning February 25, 2009. Everyone can view the proceedings front matter immediately. All sessions will take place in the Ballroom East, unless otherwise noted.</td>\n</tr>\n<tr>\n<td colspan=\"2\"><b>Proceedings Front Matter</b>: \n          <a href=\"title.pdf\">Title Page</a> | \n          <a href=\"organizers.pdf\">Conference Organizers and External Reviewers</a> | <br/>\n<a href=\"contents.pdf\">Table of Contents</a> |\n          <a href=\"index.pdf\">Index of Authors</a> |\n          <a href=\"message.pdf\">Message from the Program Co-Chairs</a>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"10\" width=\"100%\">\n<img alt=\"\" height=\"5\" src=\"../art/dot_clear.gif\" width=\"100\"/></td>\n</tr>\n<!--End Front Matter-->\n<!--BEGIN WEDNESDAY-->\n<tr>\n<td colspan=\"2\"><b>Tech Sessions</b>: <a href=\"#wed\">Wednesday, February 25</a> | <a href=\"#thurs\">Thursday, February 26</a> | <a href=\"#fri\">Friday, February 27</a>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></td>\n</tr>\n<tr>\n<td class=\"techday\" colspan=\"2\"><a name=\"wed\"></a>Wednesday, February 25</td>\n</tr>\n<tr>\n<td class=\"techtime\">9:00 a.m.&#8211;10:30 a.m.</td>\n<td class=\"techtime2\">Wednesday</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<p class=\"techtitle\">Opening Remarks and Best Paper Awards</p>\n<p class=\"techchairs\">FAST '09 Program Co-Chairs: Margo Seltzer, <i>Harvard University;</i>\nRic Wheeler, <i>Red Hat</i><br/>\n<img alt=\"\" height=\"10\" src=\"../art/dot_clear.gif\"/></p>\n<p class=\"techtitle\"><a href=\"../award.html\">2009 IEEE Reynold B. Johnson Information Storage Systems Award</a></p>\n<p class=\"techchairs\"><i>Sponsored by the IBM Almaden Research Center</i><br/>\n<img alt=\"\" height=\"10\" src=\"../art/dot_clear.gif\"/></p>\n<p class=\"techtitle\">Keynote Address: Cloud Storage FUD (Failure, Uncertainty, and Durability)</p>\n<p class=\"techchairs\"> by Alyssa Henry, <i>General Manager of Amazon Simple Storage (S3)</i></p>\n<p class=\"techdesc\">Failure and uncertainty play a key role when engineering a general purpose online storage system to be durable, available, scalable, and cost effective. I'll share some of the uncertainty we've encountered and the impact of that uncertainty on the design of the system. I'll also cover some of the hardware and network failures we've encountered, others that we anticipate occurring, and how we've engineered Amazon S3 to be resilient to them.</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/keynote-address-cloud-storage-fud-failure-uncertainty-and-durability\">View the video</a>\n</p>\n<p><img alt=\"MP3 Icon\" class=\"mp3\" height=\"25\" src=\"/legacy/graphics/mp3_icon.gif\" title=\"Download the MP3\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/keynote-address-cloud-storage-fud-failure-uncertainty-and-durability\">Listen in MP3 format</a>\n</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></td>\n</tr>\n<tr>\n<td class=\"techtime\" colspan=\"2\">10:30 a.m.&#8211;11:00 a.m.&#8195;&#8195;Break</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"10\" width=\"100%\">\n<img alt=\"\" height=\"10\" src=\"../art/dot_clear.gif\" width=\"100\"/></td>\n</tr>\n<tr>\n<td class=\"techtime\">11:00 a.m.&#8211;12:30 p.m.</td>\n<td class=\"techtime2\">Wednesday</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<p class=\"techtitle\">Augmenting File System Functionality</p>\n<p class=\"techchairs\">Session Chair: Ethan Miller, <i>University of California, Santa Cruz</i></p>\n<p class=\"techdesc\"><b>The Case of the Fake Picasso: Preventing History Forgery with Secure Provenance</b><br/>\n\t\tRagib Hasan, <i>University of Illinois at Urbana-Champaign; </i>Radu Sion, <i>Stony Brook University; </i>Marianne Winslett, <i>University of Illinois at Urbana-Champaign</i></p>\n<p class=\"paperfiles\">\n\t\tPaper in <a href=\"full_papers/hasan/hasan_html/index.html\">HTML</a> |\n\t\t<a href=\"full_papers/hasan/hasan.pdf\">PDF</a> |\n\t\t<a href=\"slides/hasan.pdf\">Slides</a>\n</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/case-fake-picasso-preventing-history-forgery-secure-provenance\">View the video</a>\n</p>\n<p><img alt=\"MP3 Icon\" class=\"mp3\" height=\"25\" src=\"/legacy/graphics/mp3_icon.gif\" title=\"Download the MP3\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/case-fake-picasso-preventing-history-forgery-secure-provenance\">Listen in MP3 format</a>\n</p>\n<p><img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></p>\n<p class=\"techdesc\"><b>Causality-Based Versioning</b><br/>\n\t\tKiran-Kumar Muniswamy-Reddy and David A. Holland, <i>Harvard University</i></p>\n<p class=\"paperfiles\">\n\t\tPaper in <a href=\"full_papers/muniswamy-reddy/muniswamy-reddy_html/index.html\">HTML</a> |\n\t\t<a href=\"full_papers/muniswamy-reddy/muniswamy-reddy.pdf\">PDF</a> |\n\t\t<a href=\"slides/muniswamy.pdf\">Slides</a>\n</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/causality-based-versioning\">View the video</a>\n</p>\n<p><img alt=\"MP3 Icon\" class=\"mp3\" height=\"25\" src=\"/legacy/graphics/mp3_icon.gif\" title=\"Download the MP3\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/causality-based-versioning\">Listen in MP3 format</a>\n</p>\n<p><img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></p>\n<p class=\"techdesc\"><b>Enabling Transactional File Access via Lightweight Kernel Extensions</b><br/>\n\t\tRichard P. Spillane, Sachin Gaikwad, Manjunath Chinni, and Erez Zadok, <i>Stony Brook University; </i>Charles P. Wright, <i>IBM T.J. Watson Research Center</i></p>\n<p class=\"paperfiles\">\n\t\tPaper in <a href=\"full_papers/spillane/spillane_html/index.html\">HTML</a> |\n\t\t<a href=\"full_papers/spillane/spillane.pdf\">PDF</a> |\n\t\t<a href=\"slides/spillane.pdf\">Slides</a>\n</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/enabling-transactional-file-access-lightweight-kernel-extensions\">View the video</a>\n</p>\n<p><img alt=\"MP3 Icon\" class=\"mp3\" height=\"25\" src=\"/legacy/graphics/mp3_icon.gif\" title=\"Download the MP3\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/enabling-transactional-file-access-lightweight-kernel-extensions\">Listen in MP3 format</a>\n</p>\n<p><img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></p>\n</td>\n</tr>\n<tr>\n<td class=\"techtime\" colspan=\"2\">12:30 p.m.&#8211;2:00 p.m.&#8195;&#8195;Lunch (on your own)</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"10\" width=\"100%\">\n<img alt=\"\" height=\"10\" src=\"../art/dot_clear.gif\" width=\"100\"/></td>\n</tr>\n<tr>\n<td class=\"techtime\">2:00 p.m.&#8211;3:00 p.m.</td>\n<td class=\"techtime2\">Wednesday</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<p class=\"techtitle\">Diagnosis</p>\n<p class=\"techchairs\">Session Chair: Bill Bolosky, <i>Microsoft Research, Redmond</i></p>\n<p class=\"techdesc\"><b>Understanding Customer Problem Troubleshooting from Storage System Logs</b><br/>\n\t\tWeihang Jiang and Chongfeng Hu, <i>University of Illinois at Urbana-Champaign;</i> Shankar Pasupathy and Arkady Kanevsky, <i>NetApp, Inc.;</i> Zhenmin Li, <i>Pattern Insight, Inc.; </i>Yuanyuan Zhou, <i>University of Illinois at Urbana-Champaign</i></p>\n<p class=\"paperfiles\">\n\t\tPaper in <a href=\"full_papers/jiang/jiang_html/index.html\">HTML</a> |\n\t\t<a href=\"full_papers/jiang/jiang.pdf\">PDF</a> |\n\t\t<a href=\"slides/jiang.pdf\">Slides</a>\n</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/understanding-customer-problem-troubleshooting-storage-system-logs\">View the video</a>\n</p>\n<p><img alt=\"MP3 Icon\" class=\"mp3\" height=\"25\" src=\"/legacy/graphics/mp3_icon.gif\" title=\"Download the MP3\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/understanding-customer-problem-troubleshooting-storage-system-logs\">Listen in MP3 format</a>\n</p>\n<p><img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></p>\n<p class=\"techdesc\"><b>DIADS: Addressing the \"My-Problem-or-Yours\" Syndrome with\n\t\tIntegrated SAN and Database Diagnosis</b><br/>\n\t\tShivnath Babu and Nedyalko Borisov, <i>Duke University; </i>Sandeep Uttamchandani, Ramani Routray, and Aameek Singh, <i>IBM Almaden Research Center</i></p>\n<p class=\"paperfiles\">\n\t\tPaper in <a href=\"full_papers/babu/babu_html/index.html\">HTML</a> |\n\t\t<a href=\"full_papers/babu/babu.pdf\">PDF</a> |\n\t\t<a href=\"slides/babu.pdf\">Slides</a>\n</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/diads-addressing-my-problem-or-yours-syndrome-integrated-san-and-database\">View the video</a>\n</p>\n<p><img alt=\"MP3 Icon\" class=\"mp3\" height=\"25\" src=\"/legacy/graphics/mp3_icon.gif\" title=\"Download the MP3\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/diads-addressing-my-problem-or-yours-syndrome-integrated-san-and-database\">Listen in MP3 format</a>\n</p>\n<p><img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></p>\n</td></tr><tr>\n<td class=\"techtime\" colspan=\"2\">3:00 p.m..&#8211;3:30 p.m.&#8195;&#8195;Break</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"10\" width=\"100%\">\n<img alt=\"\" height=\"10\" src=\"../art/dot_clear.gif\" width=\"100\"/></td>\n</tr>\n<tr>\n<td class=\"techtime\">3:30 p.m.&#8211;5:00 p.m.</td>\n<td class=\"techtime2\">Ballroom East</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<p class=\"techtitle\">Work-in-Progress Reports (WiPs)</p>\n<p class=\"techchairs\">Session Chair: Geoff Kuenning, <i>Harvey Mudd College</i></p>\n<p class=\"techdesc\">The FAST technical sessions will include a session for\n\t\tWork-in-Progress reports, preliminary results, and \"outrageous\"\n\t\topinion statements. The abstracts of the FAST '09 WiPs are available <a href=\"../wips.html\">here</a>.</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"/legacy/media/events/fast09/tech/videos/wips.mov\">View the video</a>\n</p>\n<p><img alt=\"MP3 Icon\" class=\"mp3\" height=\"25\" src=\"/legacy/graphics/mp3_icon.gif\" title=\"Download the MP3\" width=\"25\"/> <a href=\"/legacy/media/events/fast09/tech/mp3/wips.mp3\">Listen in MP3 format</a>\n</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" height=\"10\" width=\"100%\">\n<img alt=\"\" height=\"10\" src=\"../art/dot_clear.gif\" width=\"100\"/></td>\n</tr>\n<tr>\n<td class=\"techtime\">5:30 p.m.&#8211;7:00 p.m.</td>\n<td class=\"techtime2\">Ballroom West</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<p class=\"techtitle\">Poster Session & Happy Hour</p>\n<p class=\"techdesc\">Held in conjunction with a happy hour, the poster session will allow researchers to present recent and ongoing projects. The list of <a href=\"../poster.html\">accepted posters</a> is now available.\n</p>\n</td>\n</tr>\n<!--END WEDNESDAY-->\n<tr>\n<td colspan=\"2\" height=\"10\" width=\"100%\">\n<img alt=\"\" height=\"10\" src=\"../art/dot_clear.gif\" width=\"100\"/></td>\n</tr>\n<!--BEGIN THURSDAY-->\n<tr>\n<td><a href=\"#wed\">Wednesday, February 25</a> | <a href=\"#thurs\">Thursday, February 26</a> | <a href=\"#fri\">Friday, February 27</a>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></td>\n</tr>\n<tr>\n<td class=\"techday\" colspan=\"2\"><a name=\"thurs\"></a>Thursday, February 26</td>\n</tr>\n<tr>\n<td class=\"techtime\">9:00 a.m.&#8211;10:30 a.m.</td>\n<td class=\"techtime2\">Thursday</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<p class=\"techtitle\">Scheduling</p>\n<p class=\"techchairs\">Session Chair: Raju Rangaswami, <i>Florida International University</i></p>\n<p class=\"techdesc\"><b>Dynamic Resource Allocation for Database Servers Running on Virtual Storage</b><br/>\n\t\tGokul Soundararajan, Daniel Lupei, Saeed Ghanbari, Adrian Daniel Popescu, Jin Chen, and Cristiana Amza, <i>University of Toronto</i></p>\n<p class=\"paperfiles\">\n\t\tPaper in <a href=\"full_papers/soundararajan/soundararajan_html/index.html\">HTML</a> |\n\t\t<a href=\"full_papers/soundararajan/soundararajan.pdf\">PDF</a> |\n\t\t<a href=\"slides/soundararajan.pdf\">Slides</a>\n</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/dynamic-resource-allocation-database-servers-running-virtual-storage\">View the video</a>\n</p>\n<p><img alt=\"MP3 Icon\" class=\"mp3\" height=\"25\" src=\"/legacy/graphics/mp3_icon.gif\" title=\"Download the MP3\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/dynamic-resource-allocation-database-servers-running-virtual-storage\">Listen in MP3 format</a>\n</p>\n<p><img alt=\"\" height=\"1\" src=\"../art/dot_clear.gif\"/></p>\n<p class=\"techdesc\"><b>PARDA: Proportional Allocation of Resources for Distributed Storage Access</b><br/>\n\t\tAjay Gulati, Irfan Ahmad, and Carl A. Waldspurger, <i>VMware Inc.</i></p>\n<p class=\"paperfiles\">\n\t\tPaper in <a href=\"full_papers/gulati/gulati_html/index.html\">HTML</a> |\n\t\t<a href=\"full_papers/gulati/gulati.pdf\">PDF</a> |\n\t\t<a href=\"slides/gulati.pdf\">Slides</a>\n</p>\n<p><img alt=\"Video\" height=\"25\" src=\"/legacy/graphics/video_icon.gif\" style=\"margin-bottom:-13px\" title=\"View the video\" width=\"25\"/> <a href=\"https://www.usenix.org/conference/fast-09/parda-proportional-allocation-resources-d