{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cs221-retrieval-run-v1"
    },
    "run_id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "specification": {
      "$ref": "#/$defs/specification"
    },
    "timestamp": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_key": {
            "type": "string"
          },
          "status": {
            "enum": [
              "complete",
              "failed",
              "pending"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "record_key",
          "status",
          "path",
          "sha256",
          "candidate_count"
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "complete",
        "failed",
        "pending"
      ]
    },
    "state": {
      "enum": [
        "complete",
        "complete_with_errors",
        "interrupted"
      ]
    },
    "checkpoint_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "indexing_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "quality_evaluation": {
      "const": "not_performed"
    },
    "annotation_depth": {
      "const": 10
    },
    "context_max_hits": {
      "const": 5
    },
    "optional_reranker": {
      "type": [
        "string",
        "object"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "fingerprint",
    "specification",
    "timestamp",
    "records",
    "counts",
    "state",
    "checkpoint_index_sha256",
    "indexing_history",
    "quality_evaluation",
    "annotation_depth",
    "context_max_hits",
    "optional_reranker",
    "synthetic"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs221:retrieval-run:v1",
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "cs221-retrieval-record-v1"
        },
        "record_key": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "condition": {
          "enum": [
            "IR-B",
            "IR-D",
            "IR-H",
            "IR-R"
          ]
        },
        "incident_id": {
          "type": "string"
        },
        "representation_id": {
          "enum": [
            "R1",
            "R2",
            "R3"
          ]
        },
        "query_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_version": {
          "type": "string"
        },
        "window_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "corpus_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "complete",
            "failed"
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "exception_type": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "exception_type"
              ]
            }
          ]
        },
        "hits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hit"
          }
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "requested_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "empty": {
          "type": "boolean"
        },
        "short": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "string"
        },
        "timings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query_encode_seconds": {
              "type": "number",
              "minimum": 0
            },
            "search_seconds": {
              "type": "number",
              "minimum": 0
            },
            "fusion_seconds": {
              "type": "number",
              "minimum": 0
            },
            "rerank_seconds": {
              "type": "number",
              "minimum": 0
            },
            "total_seconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "query_encode_seconds",
            "search_seconds",
            "fusion_seconds",
            "rerank_seconds",
            "total_seconds"
          ]
        },
        "timing_semantics": {
          "type": "string"
        },
        "token_audits": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "record_key",
        "run_id",
        "fingerprint",
        "condition",
        "incident_id",
        "representation_id",
        "query_hash",
        "task_version",
        "window_hash",
        "corpus_hash",
        "config_hash",
        "status",
        "error",
        "hits",
        "candidate_count",
        "requested_depth",
        "empty",
        "short",
        "timestamp",
        "timings",
        "timing_semantics",
        "token_audits",
        "synthetic"
      ]
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "chunk_id",
        "document_id",
        "rank",
        "score",
        "content_hash"
      ]
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "cs221-retrieval-spec-v1"
        },
        "mode": {
          "enum": [
            "pilot",
            "frozen",
            "fixture"
          ]
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "config": {
          "type": "object"
        },
        "environment": {
          "type": "object"
        },
        "environment_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementation_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "implementation_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "corpus_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "corpus_manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query_manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "allowlist_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "f1_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "test_input_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "representation": {
          "enum": [
            "R1",
            "R2",
            "R3"
          ]
        },
        "task_version": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IR-B",
              "IR-D",
              "IR-H",
              "IR-R"
            ]
          }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "incident_id": {
                "type": "string"
              },
              "representation_id": {
                "enum": [
                  "R1",
                  "R2",
                  "R3"
                ]
              },
              "query_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "window_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "task_version": {
                "type": "string"
              }
            },
            "required": [
              "incident_id",
              "representation_id",
              "query_hash",
              "window_hash",
              "task_version"
            ]
          }
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chunk_id": {
                "type": "string"
              },
              "document_id": {
                "type": "string"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "chunk_id",
              "document_id",
              "content_hash"
            ]
          }
        },
        "tokenizer_asset_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_schema_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schema_version",
        "mode",
        "config_hash",
        "config",
        "environment",
        "environment_hash",
        "implementation_hashes",
        "implementation_hash",
        "corpus_hash",
        "corpus_manifest_hash",
        "query_manifest_hash",
        "input_manifest_hash",
        "allowlist_hash",
        "f1_hash",
        "test_input_hash",
        "representation",
        "task_version",
        "depth",
        "conditions",
        "queries",
        "chunks",
        "tokenizer_asset_hash",
        "run_schema_hash"
      ]
    }
  },
  "description": "Nested per-incident/condition records retain empty and failed outcomes. Consumers verify manifest fingerprint, external SHA256 pin, index, record checksums and semantic rank/provenance invariants."
}
